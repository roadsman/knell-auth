PORT=3000
DATABASE_URL=postgres://localhost:5432/knell
JWT_SECRET=your-secret-key-here-change-in-production

DB_POOL_MAX=20
DB_POOL_MIN=5
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

JWT_EXPIRES_IN=15m
SESSION_DURATION=604800000
MAX_CONCURRENT_SESSIONS=5

MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900000
ATTEMPT_WINDOW=900000

RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW=15m
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW=15m

VERIFICATION_TOKEN_DURATION=86400000

EMAIL_ENABLED=false
EMAIL_FROM=noreply@knell.local
BASE_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
